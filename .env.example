# Create a free project at https://cloud.appwrite.io, then copy its values here.
# See README.md for the full setup steps (database, collection, Google provider).
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID=""
VITE_APPWRITE_DATABASE_ID=""
VITE_APPWRITE_BOOKMARKS_COLLECTION_ID=""
VITE_APPWRITE_ALBUMS_COLLECTION_ID=""

# Server-only (no VITE_ prefix, never sent to the browser). Used to add
# people to an album's team the instant they open an invite link (needs
# teams.write), and by the deadline-notification cron (needs users.read to
# look up who to notify, and documents.read on both collections to find
# upcoming job deadlines). Create/edit it under Project Settings -> API Keys.
APPWRITE_API_KEY=""

# Web Push (deadline reminder notifications, sent 4 days before, 1 day
# before, and the day of a job's deadline, at the user's chosen hour).
# Generate a keypair with `npx web-push generate-vapid-keys`.
# Public key is safe to expose to the client; the private key and cron secret
# must stay server-only. All four of these also need to be added to your
# Vercel project's environment variables — this .env file only covers local
# dev, it isn't read by the deployed app.
VITE_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
CRON_SECRET=""

# Email deadline reminders (optional, on top of push above). Get a free API
# key at https://resend.com/api-keys. RESEND_FROM_EMAIL can be
# "onboarding@resend.dev" for testing, or an address on a domain you've
# verified in Resend for production. SITE_URL is only needed to make links
# in the email absolute — on Vercel it falls back to the deployment's own
# VERCEL_URL automatically, so you can usually leave it unset.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
SITE_URL=""

# AI search (the sparkle button in the search bar) — describe a bookmark in
# plain language instead of matching its title/tags exactly. Get a free key
# at https://aistudio.google.com/apikey.
GEMINI_API_KEY=""
