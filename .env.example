# Create a free project at https://cloud.appwrite.io, then copy its values here.
# See README.md for the full setup steps (database, collection, Google provider).
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID=""
VITE_APPWRITE_DATABASE_ID=""
VITE_APPWRITE_BOOKMARKS_COLLECTION_ID=""
VITE_APPWRITE_ALBUMS_COLLECTION_ID=""

# Server-only (no VITE_ prefix, never sent to the browser) — used to add
# people to an album's team the instant they open an invite link, with no
# email round trip. Create it under Project Settings -> API Keys with just
# the teams.write scope.
APPWRITE_API_KEY=""
